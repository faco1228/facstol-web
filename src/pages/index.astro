---
import { Image } from 'astro:assets';
import heroDarkKitchen from '../assets/galeria/kuchyne/kuchyna13.jpg';
import heroLightKitchen from '../assets/galeria/kuchyne/kuchyna4.jpg';
import heroSalon from '../assets/galeria/pre-firmy/ostatne8.jpg';
import heroBedroom from '../assets/galeria/spalne/spalna4.jpg';
import workshopImage from '../assets/dielna/title1.jpg';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { completedJobs, locationText, site, yearsOfPractice } from '../config';
import { faq } from '../data/faq';
import { mainCategories, otherCategories } from '../data/gallery';
import { steps } from '../data/steps';
import BaseLayout from '../layouts/BaseLayout.astro';
import { plural } from '../utils';

const cards = [
  ...mainCategories.map((c) => ({ href: `/galeria/#${c.slug}`, title: c.title, count: c.photos.length, photo: c.coverPhoto })),
  {
    href: '/galeria/#ostatne',
    title: 'Ďalšie realizácie',
    count: otherCategories.reduce((sum, c) => sum + c.photos.length, 0),
    photo: otherCategories[0].coverPhoto,
  },
];

// The CSS crossfade is timed for exactly 4 slides: 6 s each, 1.5 s fade, 24 s cycle
const heroSlides = [
  { src: heroDarkKitchen, alt: 'Kuchyňa na mieru s ostrovčekom, tmavými skrinkami a dubovou pracovnou doskou' },
  { src: heroLightKitchen, alt: 'Svetlá kuchyňa s ostrovčekom a drevenými lamelami' },
  { src: heroSalon, alt: 'Zariadenie kaderníckeho salónu s okrúhlymi zrkadlami' },
  { src: heroBedroom, alt: 'Spálňa na mieru s posteľou a skriňami nad lôžkom' },
];

// Dividers between facts are left/top box-shadows clipped by the grid – works for any column count
const facts = [
  { value: yearsOfPractice, suffix: '+', label: 'rokov praxe v stolárstve' },
  { value: completedJobs, suffix: '+', label: 'zrealizovaných zákaziek' },
  { value: '0', suffix: ' €', label: 'obhliadka u vás' },
  { value: '3D', suffix: '', label: 'vizualizácia na požiadanie' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-slides">
      {
        heroSlides.map((slide, i) => (
          <Image
            src={slide.src}
            alt={i === 0 ? slide.alt : ''}
            width={2400}
            widths={[640, 960, 1280, 1920, 2400]}
            sizes="100vw"
            priority={i === 0}
            class="hero-img"
          />
        ))
      }
    </div>
    <div class="container hero-content animate-in">
      <p class="eyebrow">Stolárstvo {site.owner} · {site.city}</p>
      <h1>Poctivá stolárska práca na&nbsp;mieru</h1>
      <p class="hero-lead">
        Kuchyne, vstavané skrine, kúpeľne aj detské izby. Navrhnem, vyrobím a namontujem nábytok presne podľa vášho
        priestoru – {site.cityIn} aj kdekoľvek na Slovensku.
      </p>
      <div class="actions">
        <a href="/galeria/" class="btn btn-primary">
          Pozrieť realizácie
          <Icon name="arrow" />
        </a>
        <a href="/kontakt/#formular" class="btn btn-ghost-light">Obhliadka zdarma</a>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="V skratke">
    <div class="container">
      <div class="facts-grid">
      {
        facts.map((fact) => (
          <div class="fact">
            <strong>
              <span data-count-to={typeof fact.value === 'number' ? fact.value : undefined}>{fact.value}</span>
              <span class="suffix">{fact.suffix}</span>
            </strong>
            <span>{fact.label}</span>
          </div>
        ))
      }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Čo vyrábam</p>
        <h2>Nábytok do každej miestnosti</h2>
        <p class="lead">Každý kus je originál – navrhnutý pre konkrétny priestor a konkrétnych ľudí.</p>
      </div>

      <ul class="cards">
        {
          cards.map((card, i) => (
            <li data-reveal style={`--delay: ${(i % 5) * 70}ms`}>
              <a href={card.href} class="card">
                <Image
                  src={card.photo.src}
                  alt=""
                  width={640}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw"
                />
                <span class="card-text">
                  <span class="card-title">{card.title}</span>
                  <span class="card-count">{plural(card.count, ['fotka', 'fotky', 'fotiek'])}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section process">
    <div class="container process-grid">
      <div class="process-media" data-reveal>
        <Image
          src={workshopImage}
          alt="Meranie a značenie dosky v stolárskej dielni"
          width={960}
          widths={[480, 720, 960]}
          sizes="(min-width: 960px) 40vw, 100vw"
        />
      </div>
      <div>
        <div class="section-head" data-reveal>
          <p class="eyebrow">Ako to prebieha</p>
          <h2>Od prvého nápadu po hotový nábytok</h2>
        </div>
        <ol class="steps">
          {
            steps.map((step, i) => (
              <li data-reveal style={`--delay: ${i * 90}ms`}>
                <span class="hex-icon">
                  <Icon name={step.icon} />
                </span>
                <div>
                  <h3>
                    <span class="step-num">{i + 1}.</span> {step.title}
                  </h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="area">
    <div class="container" data-reveal>
      <div class="area-inner">
        <span class="area-hex">
          <Icon name="pin" size={30} />
        </span>
        <div>
          <h2>{site.city} a celé Slovensko</h2>
          <p>{locationText} Obhliadka je zadarmo.</p>
        </div>
        <a href="/kontakt/#formular" class="btn btn-primary">
          Dohodnúť obhliadku
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Časté otázky</p>
        <h2>Čo vás môže zaujímať</h2>
        <p class="lead">Nenašli ste odpoveď? <a href="/kontakt/">Ozvite sa</a> – rád poradím.</p>
      </div>
      <div class="faq" data-reveal>
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(88vh, 820px);
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-slides {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--dark);
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-img) {
      opacity: 0;
      animation: hero-slide 24s linear infinite both;
    }

    .hero :global(.hero-img:nth-child(1)) {
      animation-delay: -1.5s;
    }

    .hero :global(.hero-img:nth-child(2)) {
      animation-delay: 4.5s;
    }

    .hero :global(.hero-img:nth-child(3)) {
      animation-delay: 10.5s;
    }

    .hero :global(.hero-img:nth-child(4)) {
      animation-delay: 16.5s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-img:not(:first-child)) {
      display: none;
    }
  }

  @keyframes hero-slide {
    0% {
      opacity: 0;
      transform: scale(1.08);
    }
    6.25% {
      opacity: 1;
    }
    25% {
      opacity: 1;
    }
    31.25% {
      opacity: 0;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(16 15 13 / 0.88) 0%, rgb(16 15 13 / 0.35) 55%, rgb(16 15 13 / 0.15) 100%),
      linear-gradient(to right, rgb(16 15 13 / 0.6), transparent 70%);
  }

  .hero-content {
    padding-block: clamp(96px, 14vw, 160px) clamp(48px, 7vw, 88px);
  }

  .hero .eyebrow {
    color: var(--accent);
  }

  .hero h1 {
    margin-top: 16px;
    max-width: 14ch;
  }

  .hero-lead {
    margin-top: 20px;
    max-width: 52ch;
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    color: rgb(255 255 255 / 0.9);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .facts {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
  }

  .fact {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 28px 24px;
    box-shadow:
      -1px 0 0 var(--line),
      0 -1px 0 var(--line);
  }

  .fact strong {
    font-family: var(--font-display);
    font-size: clamp(2rem, 2vw + 1rem, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .fact .suffix {
    color: var(--accent-ink);
  }

  .fact [data-count-to] {
    font-variant-numeric: tabular-nums;
  }

  .fact > span {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .card :global(img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(16 15 13 / 0.82), transparent 55%);
  }

  .card:hover {
    color: #fff;
  }

  .card:hover :global(img) {
    transform: scale(1.05);
  }

  .card-text {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    padding: 16px;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .card-count {
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.8);
  }

  .process {
    background: var(--surface);
  }

  .process-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .process-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .steps {
    display: grid;
    gap: 28px;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
  }

  .step-num {
    color: var(--accent-ink);
  }

  .steps p {
    margin-top: 6px;
    color: var(--muted);
  }

  .area {
    padding-top: var(--section);
  }

  .area-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px 32px;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .area-hex {
    display: grid;
    place-items: center;
    width: 76px;
    height: 82px;
    clip-path: var(--hexagon);
    background: var(--accent);
    color: var(--ink);
  }

  .area h2 {
    font-size: clamp(1.5rem, 1.5vw + 1rem, 2rem);
  }

  .area p {
    margin-top: 8px;
    max-width: 62ch;
    color: var(--muted);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .faq {
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 34px;
    clip-path: var(--hexagon);
    background: var(--accent-soft);
    color: #3f5c09;
    font-size: 1.25rem;
    font-weight: 500;
    transition: transform 0.2s;
  }

  .faq details[open] summary::after {
    content: '−';
    background: var(--accent);
    color: var(--ink);
  }

  .faq details p {
    padding-bottom: 20px;
    max-width: 62ch;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .cards li:last-child {
      grid-column: span 3;
    }

    .cards li:last-child .card {
      aspect-ratio: 16 / 7;
    }
  }

  @media (max-width: 959px) {
    .process-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .process-media :global(img) {
      aspect-ratio: 16 / 10;
    }

    .area-inner {
      grid-template-columns: auto 1fr;
    }

    .area-inner .btn {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .facts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .cards li:last-child {
      grid-column: span 2;
    }

    .card-text {
      padding: 12px;
    }

    .card-title {
      font-size: 1.0625rem;
    }

    .facts-grid {
      grid-template-columns: 1fr;
    }

    .fact {
      grid-template-columns: 5.5rem 1fr;
      align-items: center;
      gap: 16px;
      padding: 18px 0;
    }
  }
</style>
